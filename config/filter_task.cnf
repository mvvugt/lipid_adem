# pyjasub config -- filters each gene x study pair's summary stats (GWAS
# Catalog harmonised, or FinnGen) to MAF < 0.01 in the gene's flanked region

[qsub]
step=1
batch=50
mem=3G
shell=/bin/bash
time=01:00:00
nodes=None
tmp_size=2G
tmp_dir=/home/rmgpmva/Scratch/lipid_adem/filter_task_tmp

[logs]
# must match `Paths.FILTER_TASK_LOGS` in src/project_constants.py
log_dir=/myriadfs/home/rmgpmva/projects/lipid_adem/src/logs/filter_task_logs

[job_array]
ja_file=/myriadfs/home/rmgpmva/projects/lipid_adem/data/temp/tasks.tsv
task_script=/myriadfs/home/rmgpmva/projects/lipid_adem/src/filter_gwas_cat.sh

# column to verify.
outfiles=outfile
# inputs are remote GWAS Catalog/FinnGen URLs, so only check outfiles

[script]
verbose=true
