# pyjasub config -- filters each study's summary stats (GWAS Catalog
# harmonised/raw, or FinnGen) to every gene's flanked region (MAF filter
# per Constants.MAF_THRESHOLD; None = all in-region rows).
# One job-array row = one study (all genes in one pass); each array task
# processes `step` rows, skipping studies whose outfile already exists.
# Do not pass -w/--whole-steps: it needs the row count to be a multiple
# of `step`.

[qsub]
step=10
batch=50
mem=8G
shell=/bin/bash
time=04:00:00
nodes=None
tmp_size=2G
tmp_dir=/home/rmgpmva/Scratch/lipid_adem/filter_task_tmp

[logs]
# must match `Paths.FILTER_TASK_LOGS` in src/project_constants.py
log_dir=/myriadfs/home/rmgpmva/projects/lipid_adem/src/logs/filter_task_logs

[job_array]
ja_file=/myriadfs/home/rmgpmva/projects/lipid_adem/data/temp/tasks.tsv
task_script=/myriadfs/home/rmgpmva/projects/lipid_adem/src/filter_gwas_cat.sh

# column to verify.
outfiles=outfile
# inputs are remote GWAS Catalog/FinnGen URLs, so only check outfiles

[script]
verbose=true
