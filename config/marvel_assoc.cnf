# marvel (https://gitlab.com/mvvugt/marvel, commit eed4510, branch
# annotation) association config, shared by every gene.
# Used by src/marvel_assoc.sh, which prepends the gene's [ExpInput]
# block and sets tmp_dir/checkpoint_dir per task; output goes to
# marvelous --outpath. Keys and values MUST be TAB-separated.
# Replace every <placeholder> before running.

[PhenoInput]
phenotypes	<phenotype_file>
covariates	<covariate_file>

# one column per outcome in data/raw/icd_codes.txt (0/1); GLM-Binom gives
# log-OR (Constants.MARVEL_METHOD_SCALE)
[BinTests]
all_cause_dementia	GLM-Binom
alzheimers_dementia	GLM-Binom
vascular_dementia	GLM-Binom
frontotemporal_dementia	GLM-Binom
lewy_body_dementia	GLM-Binom
parkinsons_disease_dementia	GLM-Binom

# `model_1` is the `model` value in data/raw/marvel_results.tsv
[Covs]
model_1	<age>;<sex>;<PC1>;<PC2>;<PC3>;<PC4>;<PC5>;<PC6>;<PC7>;<PC8>;<PC9>;<PC10>

# Thomassen 2026 APOE strata (data/raw/apoe_strata.tsv); e42 in none.
# The unstratified run (`overall`) is the pooled result.
[Stratification]
e44	<apoe_col>=<e4e4>
e43	<apoe_col>=<e3e4>
e33	<apoe_col>=<e3e3>
e22_e32	<apoe_col>=<e2e2>,<e2e3>

[Options]
extract_variants	False
association_analysis	True
id_column	<id_col>
stratify_overall	True
raise_on_error	False
