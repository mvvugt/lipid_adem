# pyjasub config -- per-gene marvel association runs on Myriad (UKB).
# One job-array row = one gene (data/raw/marvel_tasks.tsv); each task runs
# marvel with the gene's config (`config` column, written by
# src/create_config.py -a) and moves
# the results to the row's `outdir` only on success; genes whose `outdir`
# exists are skipped. Set MARVEL_ENV (default `marvel`) in the submitting
# shell if the env has another name.
# Resources are estimates (marvel tests serially and re-reads the carriers
# file per variant): tune after the first gene.

[qsub]
step=1
batch=9
mem=14G
shell=/bin/bash
time=12:00:00
nodes=None
tmp_size=10G
tmp_dir=/home/rmgpmva/Scratch/lipid_adem/marvel_task_tmp

[logs]
log_dir=/myriadfs/home/rmgpmva/projects/lipid_adem/src/logs/marvel_task_logs

[job_array]
ja_file=/myriadfs/home/rmgpmva/projects/lipid_adem/data/raw/marvel_tasks.tsv
task_script=/myriadfs/home/rmgpmva/projects/lipid_adem/src/marvel_assoc.sh

# column to verify.
outfiles=outdir

[script]
verbose=true
